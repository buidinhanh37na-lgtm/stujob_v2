  mo_ta        String?               @db.VarChar(255)
  trang_thai   giao_dich_trang_thai? @default(cho_xu_ly)
  created_at   DateTime?             @default(now()) @db.Timestamp(0)
  sinh_vien    sinh_vien             @relation(fields: [sinh_vien_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "giao_dich_ibfk_1")
  nhiem_vu     nhiem_vu?             @relation(fields: [nhiem_vu_id], references: [id], onUpdate: NoAction, map: "giao_dich_ibfk_2")

  @@index([nhiem_vu_id], map: "nhiem_vu_id")
  @@index([sinh_vien_id], map: "sinh_vien_id")
}

