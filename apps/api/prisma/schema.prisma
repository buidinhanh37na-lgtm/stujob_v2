generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model bao_dam_thanh_toan {
  id                Int                            @id @default(autoincrement())
  ung_tuyen_id      Int?
  nha_tuyen_dung_id Int
  sinh_vien_id      Int
  so_tien           Decimal                        @db.Decimal(14, 2)
  trang_thai        bao_dam_thanh_toan_trang_thai? @default(cho_nap)
  ghi_chu           String?                        @db.VarChar(255)
  created_at        DateTime?                      @default(now()) @db.Timestamp(0)
  viec_lam_id       Int?
  phi_dich_vu       Decimal?                       @default(0.00) @db.Decimal(14, 2)
  ma_giao_dich      String?                        @db.VarChar(30)
  ngay_giai_ngan    DateTime?                      @db.DateTime(0)
  nha_tuyen_dung    nha_tuyen_dung                 @relation(fields: [nha_tuyen_dung_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bao_dam_thanh_toan_ibfk_2")
  sinh_vien         sinh_vien                      @relation(fields: [sinh_vien_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bao_dam_thanh_toan_ibfk_3")

  @@index([ung_tuyen_id], map: "idx_ung_tuyen")
  @@index([nha_tuyen_dung_id], map: "nha_tuyen_dung_id")
  @@index([sinh_vien_id], map: "sinh_vien_id")
}

model cau_hinh_he_thong {
  khoa       String    @id @db.VarChar(100)
  gia_tri    String?   @db.Text
  mo_ta      String?   @db.VarChar(255)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
}

model chung_chi {
  id            Int       @id @default(autoincrement())
  sinh_vien_id  Int
  ten_chung_chi String    @db.VarChar(200)
  to_chuc       String?   @db.VarChar(200)
  ngay_cap      DateTime? @db.Date
  file_url      String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  sinh_vien     sinh_vien @relation(fields: [sinh_vien_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chung_chi_ibfk_1")

  @@index([sinh_vien_id], map: "sinh_vien_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model danh_gia {
  id                Int            @id @default(autoincrement())
  nha_tuyen_dung_id Int
  sinh_vien_id      Int
  nhiem_vu_id       Int?
  diem              Int            @db.TinyInt
  nhan_xet          String?        @db.Text
  created_at        DateTime?      @default(now()) @db.Timestamp(0)
  viec_lam_id       Int?
  nha_tuyen_dung    nha_tuyen_dung @relation(fields: [nha_tuyen_dung_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "danh_gia_ibfk_1")
  sinh_vien         sinh_vien      @relation(fields: [sinh_vien_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "danh_gia_ibfk_2")
  nhiem_vu          nhiem_vu?      @relation(fields: [nhiem_vu_id], references: [id], onUpdate: NoAction, map: "danh_gia_ibfk_3")

  @@index([nha_tuyen_dung_id], map: "nha_tuyen_dung_id")
  @@index([nhiem_vu_id], map: "nhiem_vu_id")
  @@index([sinh_vien_id], map: "sinh_vien_id")
}

model giao_dich {
  id           Int                   @id @default(autoincrement())
  sinh_vien_id Int
  nhiem_vu_id  Int?
  so_tien      Decimal               @db.Decimal(14, 2)
